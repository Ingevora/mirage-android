  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ingevora</groupId>
  <artifactId>mirage</artifactId>
  <version>0.3.0</version>
  <packaging>aar</packaging>
  <name>IngevoraMirage for Android</name>
  <description>On-device lens engine: face lenses drawn into camera frames, and screen effects drawn above the app's UI.</description>
  <url>https://github.com/Ingevora/mirage-android</url>
  <organization>
    <name>Ingevora</name>
    <url>https://ingevora.com</url>
  </organization>
